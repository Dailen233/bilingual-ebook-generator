erDiagram
    USER ||--o{ USER_SESSION : "登录产生"
    USER ||--o{ UPLOAD_FILE : "上传"
    USER ||--o{ TASK : "创建"
    USER ||--o{ BOOK : "拥有"
    UPLOAD_FILE ||--o{ TASK : "被处理为"
    TASK ||--o{ CHAPTER : "提取为"
    CHAPTER ||--o{ PARAGRAPH : "包含"
    PARAGRAPH ||--o{ TRANSLATION_UNIT : "切分为"
    TASK ||--o| BOOK : "完成产出(幂等)"
    TASK o|--o| TASK : "重试(唯一)"
    BOOK ||--o{ BOOK_FILE : "生成"
    USER ||--o{ REPORT : "举报"
    USER o|--o{ REPORT : "被举报"
    BOOK o|--o{ REPORT : "被举报内容"
    REPORT ||--o{ DISPOSITION : "处置"
    USER ||--o{ DISPOSITION : "操作"
    USER ||--o{ AUDIT_LOG : "操作留痕"
    REPORT o|--o{ AUDIT_LOG : "审核上下文(可空)"
    USER ||--o{ BOOKMARK : "添加书签"
    BOOK ||--o{ BOOKMARK : "书签于"
    PARAGRAPH ||--o{ BOOKMARK : "定位到"
    USER ||--o{ READING_PROGRESS : "记录进度"
    BOOK ||--o{ READING_PROGRESS : "阅读进度"
    PARAGRAPH ||--o{ READING_PROGRESS : "读到"

    USER {
        varchar36 id PK "UUID"
        varchar255 email UK "登录邮箱"
        varchar255 password_hash "bcrypt"
        varchar100 display_name
        varchar16 role "user/admin"
        varchar16 status "active/disabled, 计划扩展"
        varchar255 disabled_reason "可空, 计划扩展"
        datetime6 disabled_at "可空, 计划扩展"
        datetime6 created_at
        datetime6 updated_at
    }
    USER_SESSION {
        varchar36 id PK
        varchar36 user_id FK
        varchar36 jti UK
        varchar16 session_type "user/admin"
        datetime6 expires_at
        datetime6 revoked_at "可空"
        datetime6 created_at
    }
    UPLOAD_FILE {
        varchar36 id PK
        varchar36 owner_id FK
        varchar255 original_name
        varchar255 storage_ref UK
        varchar16 ext "首版 .txt(带点)"
        bigint size_bytes
        char64 sha256
        datetime6 created_at
    }
    TASK {
        varchar36 id PK
        varchar36 owner_id FK
        varchar36 file_id FK
        varchar36 retry_of_task_id FK, UK "可空"
        varchar16 src_lang
        varchar16 tgt_lang
        varchar64 svc_key
        varchar128 svc_name "可空"
        varchar64 model_key "可空"
        varchar128 model_name "可空"
        varchar64 style_key
        varchar128 style_name "可空"
        varchar16 status "pending/running/done/failed"
        varchar16 stage "可空"
        varchar255 fail_reason "可空"
        int total_units
        int done_units
        int failed_units
        varchar64 completion_key UK "可空"
        datetime6 created_at
        datetime6 started_at "可空"
        datetime6 finished_at "可空"
        datetime6 updated_at
    }
    CHAPTER {
        varchar36 id PK
        varchar36 task_id FK "NOT NULL"
        int seq_no
        varchar255 title "可空"
    }
    PARAGRAPH {
        varchar36 id PK
        varchar36 chapter_id FK
        int seq_no
        text source_text
    }
    TRANSLATION_UNIT {
        varchar36 id PK
        varchar36 paragraph_id FK
        int seq_no
        text source_text
        text target_text "可空"
        varchar16 status "pending/translated/failed"
        int retry_count
    }
    BOOK {
        varchar36 id PK
        varchar36 owner_id FK
        varchar36 task_id FK, UK
        varchar255 name
        varchar16 src_lang
        varchar16 tgt_lang
        varchar128 svc_name "可空"
        varchar128 model_name "可空"
        varchar128 style_name "可空"
        varchar16 status "active/blocked/removed, 计划扩展"
        int failed_units
        datetime6 created_at
    }
    BOOK_FILE {
        varchar36 id PK
        varchar36 book_id FK
        varchar16 format "epub/pdf"
        varchar512 storage_ref
        bigint size_bytes "可空"
        char64 sha256 "可空"
        datetime6 generated_at
    }
    REPORT {
        varchar36 id PK
        varchar36 reporter_id FK
        varchar36 reported_user_id FK "可空"
        varchar36 book_id FK "可空"
        varchar255 reason
        varchar16 status "pending/under_review/resolved/dismissed"
        datetime6 created_at
    }
    DISPOSITION {
        varchar36 id PK
        varchar36 report_id FK
        varchar36 actor_id FK
        varchar16 action "approve/reject/block/delete"
        varchar512 note "可空"
        datetime6 created_at
    }
    AUDIT_LOG {
        varchar36 id PK
        varchar36 actor_id FK
        varchar36 report_id FK "可空, 审核上下文"
        varchar64 action "view_private_file 等"
        varchar32 target_type "多态, 不设FK"
        varchar36 target_id
        varchar512 detail "可空"
        datetime6 created_at
    }
    BOOKMARK {
        varchar36 id PK
        varchar36 user_id FK
        varchar36 book_id FK
        varchar36 paragraph_id FK
        varchar255 note "可空"
        datetime6 created_at
    }
    READING_PROGRESS {
        varchar36 id PK
        varchar36 user_id FK "UK(user_id,book_id)"
        varchar36 book_id FK "UK(user_id,book_id)"
        varchar36 paragraph_id FK
        datetime6 updated_at
    }
